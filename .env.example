# Backend environment for SIH26166 Registration API.
# Copy values into the host environment (Render dashboard) or a local .env
# that you do not commit. Never put real secrets in this file.

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
# Optional scientific dataset root (OHRC / LROC products outside Git).
# Not required for API process startup, /health, or an empty catalog.
# CHANDRAYAN_DATA_ROOT=

# Optional writable work root for uploads and job artifacts.
# Defaults to <repo>/outputs/api when unset.
# CHANDRAYAN_API_WORK_ROOT=

# Local bind (used by python -m api.main / scripts/run_api.py):
# SIH26166_API_HOST=127.0.0.1
# SIH26166_API_PORT=8000

# ---------------------------------------------------------------------------
# DEPLOYED DEMO (Render)
# ---------------------------------------------------------------------------
# PORT is provided by Render. Start command:
#   uvicorn api.app:app --host 0.0.0.0 --port $PORT
#
# Install:
#   pip install -e ".[api]"
#
# CHANDRAYAN_DATA_ROOT remains optional. Without it:
#   - the API starts
#   - GET /products/catalog returns data_root_configured=false
#   - GET /products/exp000 returns available=false
#   - uploads still work on the ephemeral filesystem
#
# Uploads/jobs under CHANDRAYAN_API_WORK_ROOT (or outputs/api) are ephemeral
# on Render and are lost on restart. Do not treat the demo host as durable
# scientific storage.

# Extra browser origins allowed by CORS (comma-separated). Local Vite origins
# are always included. Add the Vercel frontend origin after it exists:
# SIH26166_CORS_ORIGINS=https://your-app.vercel.app
