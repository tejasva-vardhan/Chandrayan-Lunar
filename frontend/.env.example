# Frontend environment (Vite). Copy to .env.local for local overrides.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
# Leave VITE_API_BASE_URL unset. Vite proxies /health, /products, /registration
# to http://127.0.0.1:8000 (see vite.config.ts).

# ---------------------------------------------------------------------------
# DEPLOYED DEMO (Vercel)
# ---------------------------------------------------------------------------
# Set at build time to the public Render API origin (no trailing slash):
# VITE_API_BASE_URL=https://your-service.onrender.com

# Optional: Cesium ion access token for the globe. Without it the UI still loads;
# the Cesium moon layer is skipped.
# VITE_CESIUM_ION_TOKEN=
